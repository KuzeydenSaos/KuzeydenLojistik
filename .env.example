# Postgres bağlantısı — Railway → Postgres servisinden DATABASE_URL'i kopyala
DATABASE_URL=postgresql://postgres:SIFRE@HOST:5432/railway

# Sunucu portu (Railway PORT'u kendi atar, lokalde 3000 yeterli)
PORT=3000

# Session imzalama — production'da rastgele uzun bir string
SESSION_SECRET=degistir-bunu-uzun-bir-rastgele-string

# Uygulamanın public URL'i (mail içeriklerinde kullanılır)
APP_URL=http://localhost:3000

# Mail (opsiyonel — şimdilik boş bırakabilirsin)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Şoförler — Kuzeyden Lojistik</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>* { font-family: 'Inter', sans-serif; } body { background: #f8fafc; }</style>
</head>
<body class="flex min-h-screen overflow-hidden">

<%- include('../sidebar', { currentPage: '/tms/soforler' }) %>

<main class="flex-1 ml-60 overflow-y-auto" style="max-height:100vh;">
    <div style="padding: 32px 40px; background: #fff; border-bottom: 1px solid #e2e8f0;">
        <h1 style="font-size: 24px; font-weight: 800; color: #0f172a;">Şoförler</h1>
        <p style="font-size: 13px; color: #64748b; margin-top: 4px;">Toplam <%= soforler.length %> şoför</p>
    </div>
    <div style="padding: 28px 40px;">
        <% if (soforler.length === 0) { %>
            <div style="background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 48px; text-align: center;">
                <i class="fas fa-id-card" style="font-size: 32px; color: #cbd5e1;"></i>
                <div style="font-size: 14px; font-weight: 700; color: #475569; margin-top: 12px;">Henüz şoför tanımlı değil</div>
            </div>
        <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px;">
                <% soforler.forEach(s => { %>
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                    <div style="font-size: 14px; font-weight: 800; color: #0f172a;"><%= s.ad_soyad %></div>
                    <% if (s.ehliyet_sinif) { %><div style="font-size: 11px; color: #64748b; margin-top: 4px;">Ehliyet: <%= s.ehliyet_sinif %></div><% } %>
                    <% if (s.telefon) { %><div style="font-size: 11px; color: #64748b; margin-top: 2px;"><i class="fas fa-phone" style="font-size: 9px;"></i> <%= s.telefon %></div><% } %>
                </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</main>
</body>
</html>

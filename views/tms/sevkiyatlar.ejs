<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sevkiyatlar — Kuzeyden Lojistik</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>* { font-family: 'Inter', sans-serif; } body { background: #f8fafc; }</style>
</head>
<body class="flex min-h-screen overflow-hidden">

<%- include('../sidebar', { currentPage: '/tms/sevkiyatlar' }) %>

<main class="flex-1 ml-60 overflow-y-auto" style="max-height:100vh;">
    <div style="padding: 32px 40px; background: #fff; border-bottom: 1px solid #e2e8f0;">
        <h1 style="font-size: 24px; font-weight: 800; color: #0f172a;">Sevkiyatlar</h1>
        <p style="font-size: 13px; color: #64748b; margin-top: 4px;">Toplam <%= sevkiyatlar.length %> kayıt</p>
    </div>
    <div style="padding: 28px 40px;">
        <% if (sevkiyatlar.length === 0) { %>
            <div style="background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 48px; text-align: center;">
                <i class="fas fa-route" style="font-size: 32px; color: #cbd5e1;"></i>
                <div style="font-size: 14px; font-weight: 700; color: #475569; margin-top: 12px;">Henüz sevkiyat yok</div>
                <div style="font-size: 12px; color: #94a3b8; margin-top: 6px;">İlk sevkiyatı oluşturduğunda burada listelenecek.</div>
            </div>
        <% } else { %>
            <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead style="background: #f8fafc;">
                        <tr>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Kod</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Müşteri</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Yükleme</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Boşaltma</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Araç</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sevkiyatlar.forEach(s => { %>
                        <tr style="border-top: 1px solid #f1f5f9;">
                            <td style="padding: 12px 16px; font-size: 12.5px; font-weight: 700; color: #0284c7;"><%= s.kod || '#' + s.id %></td>
                            <td style="padding: 12px 16px; font-size: 12.5px;"><%= s.musteri_ad || '—' %></td>
                            <td style="padding: 12px 16px; font-size: 12px; color: #475569;"><%= s.yukleme_yeri || '—' %></td>
                            <td style="padding: 12px 16px; font-size: 12px; color: #475569;"><%= s.bosaltma_yeri || '—' %></td>
                            <td style="padding: 12px 16px; font-size: 12px;"><%= s.plaka || '—' %></td>
                            <td style="padding: 12px 16px;"><span style="padding: 3px 9px; border-radius: 6px; background: #f1f5f9; color: #475569; font-size: 10.5px; font-weight: 700;"><%= s.durum %></span></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</main>
</body>
</html>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ürün Grupları — Kuzeyden Lojistik</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .modal-bg { position: fixed; inset: 0; background: rgba(15,23,42,0.45); display: none; align-items: center; justify-content: center; z-index: 100; padding: 20px; backdrop-filter: blur(4px); }
        .modal-bg.show { display: flex; }
        .modal { background: #fff; border-radius: 16px; width: 100%; max-width: 480px; box-shadow: var(--shadow-3); overflow: hidden; max-height: 90vh; display: flex; flex-direction: column; }
        .modal-head { padding: 18px 22px; border-bottom: 1px solid var(--s-200); display: flex; align-items: center; justify-content: space-between; }
        .modal-title { font-size: 16px; font-weight: 800; color: var(--s-900); }
        .modal-x { width: 32px; height: 32px; border-radius: 8px; background: transparent; border: 0; color: var(--s-500); font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
        .modal-x:hover { background: var(--s-100); color: var(--s-900); }
        .modal-body { padding: 22px; overflow-y: auto; }
        .modal-foot { padding: 14px 22px; border-top: 1px solid var(--s-200); display: flex; justify-content: flex-end; gap: 10px; background: var(--s-50); }
        .frm { display: grid; gap: 14px; }
        .frm .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        @media (max-width: 600px) { .frm .row { grid-template-columns: 1fr; } }
        .lbl { font-size: 12px; font-weight: 700; color: var(--s-700); margin-bottom: 6px; display: block; }
        .req { color: var(--rose-600); }
        .inp, .ta { width: 100%; padding: 10px 12px; border: 1.5px solid var(--s-200); border-radius: 10px; font-size: 13px; color: var(--s-900); background: #fff; outline: none; font-family: inherit; transition: all var(--t); }
        .inp:focus, .ta:focus { border-color: var(--p-400); box-shadow: 0 0 0 4px rgba(59,130,246,0.12); }
        .ta { min-height: 80px; resize: vertical; }
        .err-msg { font-size: 12px; color: var(--rose-600); margin-top: 4px; display: none; }
        .err-msg.show { display: block; }

        .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
        .search-w { position: relative; flex: 1; min-width: 220px; max-width: 360px; }
        .search-w i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--s-400); font-size: 13px; }
        .search-w input { width: 100%; height: 38px; padding: 0 14px 0 36px; border: 1px solid var(--s-200); border-radius: 10px; background: #fff; font-size: 13px; outline: none; transition: all var(--t); }
        .search-w input:focus { border-color: var(--p-400); box-shadow: 0 0 0 4px rgba(59,130,246,0.12); }

        .pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; }
        .pill.on  { background: var(--emerald-50); color: var(--emerald-700); }
        .pill.off { background: var(--s-100); color: var(--s-500); }
        .pill .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

        .actions { display: inline-flex; gap: 6px; }
        .ico-btn { width: 32px; height: 32px; border-radius: 8px; background: transparent; border: 1px solid var(--s-200); color: var(--s-500); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; transition: all var(--t); }
        .ico-btn:hover { color: var(--s-900); border-color: var(--s-300); background: #fff; }
        .ico-btn.danger:hover { color: var(--rose-700); border-color: var(--rose-200); background: var(--rose-50); }
    </style>
</head>
<body>

<%- include('../sidebar', { currentPage: '/tms/urun-gruplari' }) %>

<main class="app-main" id="appMain">

    <header class="topbar">
        <div class="crumb">
            <a href="/tms" style="color:var(--s-400); font-weight:600; font-size:16px;">TMS</a>
            <span class="sep"><i class="fas fa-chevron-right"></i></span>
            Ürün Grupları
        </div>
        <div class="topbar-spacer"></div>
        <% if (izin && izin.ekle) { %>
            <button class="btn primary" id="btnYeni"><i class="fas fa-plus"></i> Yeni Grup</button>
        <% } %>
    </header>

    <div class="page">
        <div class="toolbar">
            <div class="search-w">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="qInput" placeholder="Ad veya kod ara…">
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <div class="card-title">Ürün Grupları <span style="color: var(--s-400); font-weight: 600; font-size: 13px;">(<%= gruplar.length %>)</span></div>
            </div>

            <% if (gruplar.length === 0) { %>
                <div class="empty">
                    <div class="icon"><i class="fas fa-boxes-stacked"></i></div>
                    <div class="t">Henüz ürün grubu yok</div>
                    <div class="d">Sevkiyat planında kullanılacak ürün gruplarını burada tanımlarsın (örn. Beyaz Eşya, Akaryakıt).</div>
                    <% if (izin && izin.ekle) { %>
                        <button class="btn primary" style="margin-top:14px;" onclick="document.getElementById('btnYeni').click()">
                            <i class="fas fa-plus"></i> İlk Grubu Ekle
                        </button>
                    <% } %>
                </div>
            <% } else { %>
                <div style="overflow-x:auto;">
                    <table class="tbl" id="tbl">
                        <thead>
                            <tr>
                                <th style="padding-left:22px;">Ad</th>
                                <th>Kod</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                                <th style="text-align:right; padding-right:22px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% gruplar.forEach(g => { %>
                                <tr data-row data-search="<%= ((g.ad || '') + ' ' + (g.kod || '')).toLowerCase() %>">
                                    <td style="font-weight:700; color: var(--s-900);"><%= g.ad %></td>
                                    <td><%= g.kod || '—' %></td>
                                    <td style="color: var(--s-500);"><%= g.aciklama || '—' %></td>
                                    <td>
                                        <% if (g.aktif) { %>
                                            <span class="pill on"><span class="dot"></span> Aktif</span>
                                        <% } else { %>
                                            <span class="pill off"><span class="dot"></span> Pasif</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align:right; padding-right:22px;">
                                        <div class="actions">
                                            <% if (izin && izin.duzenle) { %>
                                                <button class="ico-btn" title="Düzenle" onclick='openEdit(<%- JSON.stringify(g) %>)'><i class="fas fa-pen"></i></button>
                                            <% } %>
                                            <% if (izin && izin.sil) { %>
                                                <button class="ico-btn danger" title="Sil" onclick="silGrup(<%= g.id %>, '<%= (g.ad || '').replace(/'/g, '\\\'') %>')"><i class="fas fa-trash"></i></button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</main>

<div class="modal-bg" id="modalBg">
    <div class="modal">
        <div class="modal-head">
            <div class="modal-title" id="modalTitle">Yeni Ürün Grubu</div>
            <button class="modal-x" onclick="closeModal()"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="frm" class="frm" style="margin:0;">
            <div class="modal-body">
                <input type="hidden" id="fId">
                <div class="row">
                    <div>
                        <label class="lbl">Ad <span class="req">*</span></label>
                        <input type="text" class="inp" id="fAd" required placeholder="Örn. Beyaz Eşya">
                    </div>
                    <div>
                        <label class="lbl">Kod</label>
                        <input type="text" class="inp" id="fKod" placeholder="Örn. BE">
                    </div>
                </div>
                <div>
                    <label class="lbl">Açıklama</label>
                    <textarea class="ta" id="fAciklama" placeholder="Bu grupta hangi ürünler yer alıyor?"></textarea>
                </div>
                <div id="aktifWrap" style="display:none;">
                    <label class="lbl">Durum</label>
                    <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer; padding:8px 12px; background: var(--s-50); border:1px solid var(--s-200); border-radius:10px;">
                        <input type="checkbox" id="fAktif" checked> Aktif
                    </label>
                </div>
                <div class="err-msg" id="errMsg"></div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn ghost" onclick="closeModal()">İptal</button>
                <button type="submit" class="btn primary" id="btnSave">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<script>
    const modalBg = document.getElementById('modalBg');
    const errMsg = document.getElementById('errMsg');
    function openModal() { modalBg.classList.add('show'); errMsg.classList.remove('show'); }
    function closeModal() { modalBg.classList.remove('show'); }
    modalBg.addEventListener('click', e => { if (e.target === modalBg) closeModal(); });

    function openYeni() {
        document.getElementById('modalTitle').textContent = 'Yeni Ürün Grubu';
        document.getElementById('fId').value = '';
        document.getElementById('fAd').value = '';
        document.getElementById('fKod').value = '';
        document.getElementById('fAciklama').value = '';
        document.getElementById('fAktif').checked = true;
        document.getElementById('aktifWrap').style.display = 'none';
        openModal();
        setTimeout(() => document.getElementById('fAd').focus(), 50);
    }

    function openEdit(g) {
        document.getElementById('modalTitle').textContent = 'Grubu Düzenle';
        document.getElementById('fId').value = g.id;
        document.getElementById('fAd').value = g.ad || '';
        document.getElementById('fKod').value = g.kod || '';
        document.getElementById('fAciklama').value = g.aciklama || '';
        document.getElementById('fAktif').checked = !!g.aktif;
        document.getElementById('aktifWrap').style.display = 'block';
        openModal();
    }

    document.getElementById('btnYeni')?.addEventListener('click', openYeni);

    document.getElementById('frm').addEventListener('submit', async (e) => {
        e.preventDefault();
        errMsg.classList.remove('show');
        const id = document.getElementById('fId').value;
        const data = {
            ad: document.getElementById('fAd').value.trim(),
            kod: document.getElementById('fKod').value.trim(),
            aciklama: document.getElementById('fAciklama').value.trim(),
            aktif: document.getElementById('fAktif').checked
        };
        if (!data.ad) { errMsg.textContent = 'Ad zorunlu.'; errMsg.classList.add('show'); return; }

        const btn = document.getElementById('btnSave');
        btn.disabled = true; btn.textContent = 'Kaydediliyor…';
        try {
            const url = id ? `/tms/urun-gruplari/${id}` : '/tms/urun-gruplari';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const r = await res.json();
            if (r.success) location.reload();
            else { errMsg.textContent = r.message || 'Kaydedilemedi.'; errMsg.classList.add('show'); }
        } catch {
            errMsg.textContent = 'Bağlantı hatası.'; errMsg.classList.add('show');
        }
        btn.disabled = false; btn.textContent = 'Kaydet';
    });

    async function silGrup(id, ad) {
        if (!confirm(`"${ad}" ürün grubunu silmek istediğinden emin misin?`)) return;
        try {
            const res = await fetch(`/tms/urun-gruplari/${id}/sil`, { method: 'POST' });
            const r = await res.json();
            if (r.success) location.reload();
            else alert(r.message || 'Silinemedi.');
        } catch {
            alert('Bağlantı hatası.');
        }
    }

    const qInput = document.getElementById('qInput');
    qInput?.addEventListener('input', e => {
        const q = e.target.value.trim().toLowerCase();
        document.querySelectorAll('[data-row]').forEach(tr => {
            tr.style.display = (!q || tr.getAttribute('data-search').includes(q)) ? '' : 'none';
        });
    });
</script>

</body>
</html>

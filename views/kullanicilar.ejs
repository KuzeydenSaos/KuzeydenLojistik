<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Kullanıcılar — Kuzeyden Lojistik</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>* { font-family: 'Inter', sans-serif; } body { background: #f8fafc; }</style>
</head>
<body class="flex min-h-screen overflow-hidden">

<%- include('sidebar', { currentPage: '/kullanicilar' }) %>

<main class="flex-1 ml-60 overflow-y-auto" style="max-height:100vh;">
    <div style="padding: 32px 40px; background: #fff; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: #0f172a;">Kullanıcılar</h1>
            <p style="font-size: 13px; color: #64748b; margin-top: 4px;">Toplam <%= personeller.length %> personel</p>
        </div>
    </div>
    <div style="padding: 28px 40px;">
        <% if (personeller.length === 0) { %>
            <div style="background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 48px; text-align: center;">
                <i class="fas fa-users" style="font-size: 32px; color: #cbd5e1;"></i>
                <div style="font-size: 14px; font-weight: 700; color: #475569; margin-top: 12px;">Henüz kullanıcı yok</div>
            </div>
        <% } else { %>
            <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead style="background: #f8fafc;">
                        <tr>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Ad Soyad</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">E-posta</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Departman</th>
                            <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase;">Rol</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% personeller.forEach(p => { %>
                        <tr style="border-top: 1px solid #f1f5f9;">
                            <td style="padding: 12px 16px; font-size: 13px; font-weight: 700; color: #0f172a;"><%= p.ad_soyad %></td>
                            <td style="padding: 12px 16px; font-size: 12px; color: #475569;"><%= p.email || '—' %></td>
                            <td style="padding: 12px 16px; font-size: 12px; color: #475569;"><%= p.departman || '—' %></td>
                            <td style="padding: 12px 16px;"><span style="padding: 3px 9px; border-radius: 6px; background: #eff6ff; color: #1d4ed8; font-size: 10.5px; font-weight: 700;"><%= p.rol %></span></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</main>
</body>
</html>

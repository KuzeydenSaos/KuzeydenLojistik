<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anasayfa — Kuzeyden Lojistik</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<%- include('sidebar', { currentPage: '/' }) %>

<%
    const k = (typeof kpi !== 'undefined') ? kpi : { sevkiyat:0, arac:0, sofor:0, musteri:0 };
    const lastShipments = (typeof sonSevkiyat !== 'undefined') ? sonSevkiyat : [];
    const initials = (user && user.name)
        ? user.name.split(' ').map(w => w.charAt(0).toUpperCase()).join('').slice(0, 2)
        : '?';

    function durumCls(d) {
        const map = { 'Planlandı':'sky', 'Yolda':'amber', 'Teslim':'emer', 'İptal':'rose' };
        return map[d] || 'slate';
    }
    function fmtTutar(n) {
        if (n === null || n === undefined) return '—';
        return new Intl.NumberFormat('tr-TR', { style:'currency', currency:'TRY', maximumFractionDigits:0 }).format(n);
    }
    function fmtTarih(d) {
        if (!d) return '—';
        return new Date(d).toLocaleDateString('tr-TR', { day:'2-digit', month:'short' });
    }

    const totalRevenue = lastShipments.reduce((s, x) => s + Number(x.tutar || 0), 0);
%>

<main class="app-main" id="appMain">

    <!-- Topbar -->
    <header class="topbar">
        <div class="crumb">
            Anasayfa <span class="sep"><i class="fas fa-chevron-right"></i></span>
            <span class="ctx">Kuzeyden Lojistik</span>
        </div>
        <div class="topbar-spacer"></div>
        <a href="/tms/sevkiyatlar?yeni=1" class="t-icon primary" title="Yeni sevkiyat">
            <i class="fas fa-plus"></i>
        </a>
        <button class="t-icon" title="Ara"><i class="fas fa-magnifying-glass"></i></button>
        <button class="t-icon" title="Bildirimler">
            <i class="fas fa-bell"></i>
            <span class="badge-num">3</span>
        </button>
        <div class="t-avatar" title="<%= user ? user.name : '' %>"><%= initials %></div>
    </header>

    <!-- Sayfa içeriği -->
    <div class="page">

        <!-- KPI BAR -->
        <div class="kpi-bar" style="margin-bottom:18px;">
            <div class="kpi-cell">
                <div class="kpi-top">
                    <div class="kpi-icon"><i class="fas fa-truck-moving"></i></div>
                    <div class="kpi-lbl">Yoldaki Araç</div>
                </div>
                <div class="kpi-row">
                    <div class="kpi-val"><%= k.arac %></div>
                    <span class="kpi-period">Şu an <i class="fas fa-chevron-down" style="font-size:9px;"></i></span>
                </div>
            </div>

            <div class="kpi-cell">
                <div class="kpi-top">
                    <div class="kpi-icon" style="background: var(--emerald-50); color: var(--emerald-600);"><i class="fas fa-circle-check"></i></div>
                    <div class="kpi-lbl">Tamamlanan Sevkiyat</div>
                </div>
                <div class="kpi-row">
                    <div class="kpi-val"><%= k.sevkiyat %></div>
                    <div class="kpi-meta">
                        <% if (k.sevkiyat > 0) { %>
                            <span class="kpi-chip up">+<%= k.sevkiyat %></span>
                        <% } else { %>
                            <span class="kpi-chip flat">—</span>
                        <% } %>
                        <span class="kpi-period">30 gün <i class="fas fa-chevron-down" style="font-size:9px;"></i></span>
                    </div>
                </div>
            </div>

            <div class="kpi-cell">
                <div class="kpi-top">
                    <div class="kpi-icon" style="background: var(--amber-50); color: var(--amber-600);"><i class="fas fa-calendar-day"></i></div>
                    <div class="kpi-lbl">Yaklaşan Sevkiyat</div>
                </div>
                <div class="kpi-row">
                    <div class="kpi-val"><%= k.sevkiyat %></div>
                    <span class="kpi-period">30 gün <i class="fas fa-chevron-down" style="font-size:9px;"></i></span>
                </div>
            </div>

            <div class="kpi-cell">
                <div class="kpi-top">
                    <div class="kpi-icon" style="background: var(--violet-50); color: var(--violet-600);"><i class="fas fa-chart-line"></i></div>
                    <div class="kpi-lbl">Ciro</div>
                </div>
                <div class="kpi-row">
                    <div class="kpi-val" style="font-size:24px;"><%= fmtTutar(totalRevenue) %></div>
                    <span class="kpi-period">Yıllık <i class="fas fa-chevron-down" style="font-size:9px;"></i></span>
                </div>
            </div>
        </div>

        <!-- ALERTS -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:18px;">
            <a href="/tms/araclar" class="alert">
                <div class="alert-icon rose"><i class="fas fa-truck-medical"></i></div>
                <div>
                    <div class="alert-t">Araç bakım/muayene takibi</div>
                    <div class="alert-d">Yaklaşan muayene ve servis tarihlerini buradan yönet</div>
                </div>
                <div class="alert-go"><i class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></i></div>
            </a>
            <a href="/tms/soforler" class="alert">
                <div class="alert-icon sky"><i class="fas fa-id-badge"></i></div>
                <div>
                    <div class="alert-t">Şoför ehliyet/sağlık takibi</div>
                    <div class="alert-d">Vade gelmeden önce hatırlatıcılar burada görünür</div>
                </div>
                <div class="alert-go"><i class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></i></div>
            </a>
        </div>

        <!-- ANA GRID: Sol (tablolar) + Sağ (chart + map) -->
        <div class="dash-grid">

            <div>
                <!-- TODAY'S PICKUPS -->
                <div class="card" style="margin-bottom:18px;">
                    <div class="card-head">
                        <div style="display:flex; align-items:center; gap:14px;">
                            <div class="card-title">Bugün:</div>
                            <div class="tabs">
                                <div class="tab active" data-tab="pickups">Yüklemeler</div>
                                <div class="tab" data-tab="deliveries">Teslimler</div>
                            </div>
                        </div>
                        <a href="/tms/sevkiyatlar" class="card-link">Tümünü gör <i class="fas fa-arrow-right" style="font-size:10px;"></i></a>
                    </div>
                    <% if (lastShipments.length === 0) { %>
                        <div class="empty">
                            <div class="icon"><i class="fas fa-inbox"></i></div>
                            <div class="t">Bugün için planlı yükleme yok</div>
                            <div class="d">Sevkiyat oluşturduğunda burada listelenecek.</div>
                            <a href="/tms/sevkiyatlar?yeni=1" class="btn primary" style="margin-top:14px;">
                                <i class="fas fa-plus"></i> Yeni Sevkiyat
                            </a>
                        </div>
                    <% } else { %>
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th style="padding-left:22px;">Kod</th>
                                    <th>Yükleme</th>
                                    <th>Yer</th>
                                    <th>Müşteri</th>
                                    <th>Durum</th>
                                    <th>Araç</th>
                                    <th style="padding-right:22px;">Şoför</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% lastShipments.slice(0, 4).forEach((s, i) => { %>
                                    <tr>
                                        <td>
                                            <div class="id-cell">
                                                <span class="id-dot <%= durumCls(s.durum) %>"></span>
                                                <%= s.kod || ('S-' + (5000 + i)) %>
                                            </div>
                                        </td>
                                        <td><%= fmtTarih(s.yukleme_tarihi) %></td>
                                        <td><%= s.yukleme_yeri || '—' %></td>
                                        <td><%= s.musteri_ad || '—' %></td>
                                        <td><span class="st <%= durumCls(s.durum) %>"><%= s.durum || '—' %></span></td>
                                        <td><%= s.plaka || '—' %></td>
                                        <td><div class="av-sm">SS</div></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>

                <!-- LATEST SHIPMENTS -->
                <div class="card">
                    <div class="card-head">
                        <div class="card-title">Son Sevkiyatlar</div>
                        <a href="/tms/sevkiyatlar" class="card-link">Tümünü gör <i class="fas fa-arrow-right" style="font-size:10px;"></i></a>
                    </div>
                    <% if (lastShipments.length === 0) { %>
                        <div class="empty">
                            <div class="icon"><i class="fas fa-route"></i></div>
                            <div class="t">Henüz sevkiyat yok</div>
                            <div class="d">İlk sevkiyatını oluşturduğunda burada görüneceksin.</div>
                        </div>
                    <% } else { %>
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th style="padding-left:22px;">Kod</th>
                                    <th>Durum</th>
                                    <th>Güzergah</th>
                                    <th>Müşteri</th>
                                    <th>Yükleme</th>
                                    <th>Araç</th>
                                    <th style="padding-right:22px;">Şoför</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% lastShipments.forEach((s, i) => { %>
                                    <tr>
                                        <td>
                                            <div class="id-cell">
                                                <span class="id-dot <%= durumCls(s.durum) %>"></span>
                                                <%= s.kod || ('S-' + (5000 + i)) %>
                                            </div>
                                        </td>
                                        <td><span class="st <%= durumCls(s.durum) %>"><%= s.durum || '—' %></span></td>
                                        <td><%= [s.yukleme_yeri, s.bosaltma_yeri].filter(Boolean).join(' → ') || '—' %></td>
                                        <td><%= s.musteri_ad || '—' %></td>
                                        <td><%= fmtTarih(s.yukleme_tarihi) %></td>
                                        <td><%= s.plaka || '—' %></td>
                                        <td><div class="av-sm">SS</div></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </div>

            <!-- SAĞ KOLON -->
            <div>
                <!-- COST & PROFITABILITY -->
                <div class="card" style="margin-bottom:18px;">
                    <div class="card-head">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="card-title">Maliyet & Kârlılık</div>
                        </div>
                        <span class="dd-pill">Bu hafta <i class="fas fa-chevron-down" style="font-size:9px;"></i></span>
                    </div>
                    <div class="card-pad" style="padding-top:6px;">
                        <%
                            // demo bar verisi (DB'den gelecek)
                            const demoBars = [
                                {l:'Pzt', p:30, c:18},
                                {l:'Sal', p:55, c:30},
                                {l:'Çar', p:78, c:46},
                                {l:'Per', p:64, c:32},
                                {l:'Cum', p:42, c:24},
                                {l:'Cmt', p:88, c:50},
                                {l:'Paz', p:36, c:22},
                            ];
                            const hasData = lastShipments.length > 0;
                        %>
                        <div class="chart">
                            <% demoBars.forEach(b => { %>
                                <div class="col">
                                    <div class="bars">
                                        <div class="bar"    style="height: <%= hasData ? b.p : 6 %>%; opacity: <%= hasData ? 1 : 0.4 %>;"></div>
                                        <div class="bar b2" style="height: <%= hasData ? b.c : 4 %>%; opacity: <%= hasData ? 1 : 0.4 %>;"></div>
                                    </div>
                                    <div class="lbl"><%= b.l %></div>
                                </div>
                            <% }) %>
                        </div>

                        <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:10px; margin-top:14px;">
                            <div style="background: var(--s-50); border-radius: 10px; padding: 10px 12px;">
                                <div style="font-size:14px; font-weight:800; color: var(--s-900);">₺0</div>
                                <div style="font-size:10.5px; color: var(--s-500); font-weight:600;">Toplam Ciro</div>
                            </div>
                            <div style="background: var(--s-50); border-radius: 10px; padding: 10px 12px;">
                                <div style="font-size:14px; font-weight:800; color: var(--s-900);">₺0</div>
                                <div style="font-size:10.5px; color: var(--s-500); font-weight:600;">Toplam Maliyet</div>
                            </div>
                            <div style="background: var(--s-50); border-radius: 10px; padding: 10px 12px;">
                                <div style="font-size:14px; font-weight:800; color: var(--s-900);">₺0</div>
                                <div style="font-size:10.5px; color: var(--s-500); font-weight:600;">Net Kâr</div>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px;">
                            <div class="legend">
                                <div class="it p1"><span class="sw"></span> Kârlılık</div>
                                <div class="it p2"><span class="sw"></span> Maliyet</div>
                            </div>
                            <span style="font-size:11px; color: var(--s-400); font-weight:600;">Bu hafta</span>
                        </div>
                    </div>
                </div>

                <!-- LIVE TRACKING (placeholder) -->
                <div class="card">
                    <div class="card-head">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <i class="fas fa-truck-fast" style="color: var(--p-600);"></i>
                            <div class="card-title">Canlı Takip</div>
                        </div>
                        <span class="card-link">Daha fazla</span>
                    </div>
                    <div class="card-pad" style="padding-top:0;">
                        <div class="map-wrap">
                            <% if (k.arac > 0) { %>
                                <div class="map-pin" style="top:18%; left:22%;">V-09</div>
                                <div class="map-pin alt" style="top:38%; left:62%;">V-22</div>
                                <div class="map-pin alt2" style="top:58%; left:34%;">V-03</div>
                                <div class="map-pin alt3" style="top:30%; left:78%;">V-01</div>
                            <% } else { %>
                                <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding: 0 20px;">
                                    <div style="width:48px; height:48px; border-radius:14px; background: #fff; border: 1px solid var(--s-200); color: var(--s-400); display:flex; align-items:center; justify-content:center; font-size:18px; margin-bottom:10px; box-shadow: var(--shadow-1);">
                                        <i class="fas fa-map-location-dot"></i>
                                    </div>
                                    <div style="font-size:12.5px; font-weight:700; color: var(--s-700);">Henüz aktif araç yok</div>
                                    <div style="font-size:11px; color: var(--s-500); margin-top:4px;">Filoya araç eklediğinde harita üzerinde görünecek.</div>
                                </div>
                            <% } %>
                            <div class="map-zoom">
                                <button><i class="fas fa-plus"></i></button>
                                <button><i class="fas fa-minus"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<script>
    // Tab toggle
    document.querySelectorAll('.tabs .tab').forEach(t => {
        t.addEventListener('click', () => {
            t.parentElement.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
            t.classList.add('active');
        });
    });
</script>

</body>
</html>

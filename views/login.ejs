<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş — Kuzeyden Lojistik</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: linear-gradient(135deg, #0c4a6e 0%, #075985 50%, #0c4a6e 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { background: #fff; border-radius: 22px; box-shadow: 0 24px 64px rgba(0,0,0,0.18); width: 420px; max-width: 92vw; overflow: hidden; }
        .head { padding: 36px 32px 28px; text-align: center; background: linear-gradient(180deg, #f0f9ff, #fff); border-bottom: 1px solid #e0f2fe; }
        .logo { width: 64px; height: 64px; border-radius: 18px; background: linear-gradient(135deg, #0284c7, #0369a1); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; box-shadow: 0 10px 28px rgba(2,132,199,0.3); }
        .logo i { color: #fff; font-size: 26px; }
        h1 { font-size: 20px; font-weight: 800; color: #0f172a; }
        .sub { font-size: 12.5px; color: #64748b; margin-top: 5px; }
        form { padding: 28px 32px 32px; }
        .field { margin-bottom: 14px; }
        label { display: block; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 6px; }
        input { width: 100%; padding: 12px 14px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 13.5px; outline: none; transition: border-color 0.15s; }
        input:focus { border-color: #0284c7; box-shadow: 0 0 0 3px rgba(2,132,199,0.1); }
        button { width: 100%; padding: 12px; background: #0284c7; color: #fff; border: none; border-radius: 10px; font-size: 13.5px; font-weight: 700; cursor: pointer; margin-top: 6px; transition: background 0.15s; }
        button:hover { background: #0369a1; }
        button:disabled { opacity: 0.6; cursor: not-allowed; }
        .err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 10px 14px; border-radius: 9px; font-size: 12px; margin-bottom: 14px; display: none; }
        .err.show { display: block; }
    </style>
</head>
<body>
    <div class="card">
        <div class="head">
            <div class="logo"><i class="fas fa-truck-fast"></i></div>
            <h1>Kuzeyden Lojistik</h1>
            <div class="sub">Yönetim paneline giriş</div>
        </div>
        <form id="loginForm">
            <div class="err" id="err"></div>
            <div class="field">
                <label>E-posta</label>
                <input type="email" name="email" required autocomplete="email" placeholder="ornek@kuzeydenlojistik.com">
            </div>
            <div class="field">
                <label>Şifre</label>
                <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
            </div>
            <button type="submit" id="btn">Giriş Yap</button>
        </form>
    </div>
    <script>
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target));
            const btn = document.getElementById('btn');
            const err = document.getElementById('err');
            err.classList.remove('show');
            btn.disabled = true; btn.textContent = 'Giriş yapılıyor…';
            try {
                const res = await fetch('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const r = await res.json();
                if (r.success) location.href = '/';
                else { err.textContent = r.message || 'Giriş başarısız'; err.classList.add('show'); }
            } catch {
                err.textContent = 'Bağlantı hatası'; err.classList.add('show');
            }
            btn.disabled = false; btn.textContent = 'Giriş Yap';
        });
    </script>
</body>
</html>

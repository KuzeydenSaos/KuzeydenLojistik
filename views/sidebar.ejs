<%
    const cp = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : '/';
    function isActive(prefix, exact) {
        if (exact) return cp === prefix;
        return cp === prefix || cp.startsWith(prefix + '/');
    }
%>
<aside class="sb" id="sidebar">
    <div class="sb-head">
        <div class="sb-logo"><i class="fas fa-truck-fast"></i></div>
        <div class="sb-brand">Kuzeyden</div>
    </div>

    <nav class="sb-nav">
        <a href="/" class="sb-link <%= isActive('/', true) ? 'active' : '' %>">
            <i class="fas fa-grip"></i><span>Anasayfa</span>
        </a>
        <a href="/tms" class="sb-link <%= isActive('/tms', true) ? 'active' : '' %>">
            <i class="fas fa-chart-line"></i><span>TMS Özet</span>
        </a>

        <div class="sb-section">Operasyon</div>

        <a href="/tms/sevkiyatlar" class="sb-link <%= isActive('/tms/sevkiyatlar') ? 'active' : '' %>">
            <i class="fas fa-route"></i><span>Sevkiyatlar</span>
        </a>
        <a href="/tms/araclar" class="sb-link <%= isActive('/tms/araclar') ? 'active' : '' %>">
            <i class="fas fa-truck"></i><span>Araçlar</span>
        </a>
        <a href="/tms/soforler" class="sb-link <%= isActive('/tms/soforler') ? 'active' : '' %>">
            <i class="fas fa-id-card"></i><span>Şoförler</span>
        </a>
        <a href="/tms/musteriler" class="sb-link <%= isActive('/tms/musteriler') ? 'active' : '' %>">
            <i class="fas fa-handshake"></i><span>Müşteriler</span>
        </a>

        <div class="sb-section">Sistem</div>

        <a href="/kullanicilar" class="sb-link <%= isActive('/kullanicilar') ? 'active' : '' %>">
            <i class="fas fa-users"></i><span>Kullanıcılar</span>
        </a>
        <a href="/logout" class="sb-link">
            <i class="fas fa-arrow-right-from-bracket"></i><span>Çıkış Yap</span>
        </a>
    </nav>

    <div class="sb-foot">
        <div class="sb-company">
            <div class="av"><i class="fas fa-paper-plane"></i></div>
            <div style="min-width:0; flex:1;">
                <div class="lbl">Şirket</div>
                <div class="nm">Kuzeyden Lojistik</div>
            </div>
            <div class="more"><i class="fas fa-chevron-up"></i></div>
        </div>
    </div>

    <div class="sb-collapse" id="sbCollapseBtn">
        <i class="fas fa-angles-left"></i><span>Daralt</span>
    </div>
</aside>

<script>
(function () {
    const sb = document.getElementById('sidebar');
    const btn = document.getElementById('sbCollapseBtn');
    if (!sb || !btn) return;
    const KEY = 'sb-collapsed';
    const main = document.querySelector('.app-main');

    function apply(collapsed) {
        sb.classList.toggle('collapsed', collapsed);
        if (main) main.classList.toggle('sb-collapsed', collapsed);
    }
    apply(localStorage.getItem(KEY) === '1');

    btn.addEventListener('click', () => {
        const next = !sb.classList.contains('collapsed');
        apply(next);
        localStorage.setItem(KEY, next ? '1' : '0');
    });
})();
</script>
